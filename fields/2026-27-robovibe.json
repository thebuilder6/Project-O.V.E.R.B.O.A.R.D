  "source": {
    "provenance": "Read from RoboVibe's field YAML for this season, which is embedded in the app's public bundle. RoboVibe measured it from FIRST's own field wireframe, the same document the footprints in the other field file came from.",
    "frame": "RoboVibe's coordinates are in the table's frame with the mat centred in it, so x is shifted by 179 mm. A shape's x and y are the top-left corner of its box, not its centre.",
    "checked_against": "With that reading, the models that have a single area agree with the other field file to a few millimetres.",
    "rules": "https://firstinspires.blob.core.windows.net/fll/challenge/2026-27/fll-challenge-bioglow-wireframe-grid.pdf",
    "adjust_it": "The operator can move a model on their own mat. A team that has measured their own field should trust their measurement over this file."
  },
  "mat_source": {
    "kind": "pdf",
    "url": "https://firstinspires.blob.core.windows.net/fll/challenge/2026-27/fll-challenge-bioglow-wireframe-grid.pdf",
    "page": 2,
    "mat_mm": "2004x1143",
    "credit": "FIRST's 2026-27 field guide. The mat picture is composed from it on this machine, the same way the reference simulator does it, and is not ours to ship."
  },
